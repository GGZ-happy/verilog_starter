		lw 0 1 n
		lw 0 4 Faddr	load function address
		jalr 4 7 		call function
		sw 0 3 res
end		halt
rec		sw 5 7 Stack
		lw 0 6 one
		add 5 6 5
		beq 1 0 base
		beq 6 1 base
		sw 5 1 Stack
		add 5 6 5
		lw 0 6 neg1
		add 1 6 1
		lw 0 4 Faddr
		jalr 4 7
		sw 5 3 Stack
		lw 0 6 one
		add 5 6 5
		lw 0 6 neg1
		add 1 6 1
		lw 0 4 Faddr
		jalr 4 7
		lw 0 6 neg1
		add 5 6 5
		lw 5 2 Stack
		add 2 3 3
		add 6 5 5
		lw 5 1 Stack
		beq 0 0 return
base	add 0 1 3
return	lw 0 6 neg1
		add 6 5 5
		lw 5 7 Stack
		jalr 7 4
		beq 0 0 end
Faddr	.fill rec
res		.fill 0			OUTPUT
n		.fill 9			INPUT
one		.fill 1
neg1	.fill -1
Stack	.fill 0
