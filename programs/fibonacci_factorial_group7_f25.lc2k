		nor 6 4 4
		beq 0 0 begin
end		add 0 7 3
emem1	jalr 15 14
fib		sw 5 7 Stack
		lw 0 2 one
		add 2 5 5
		beq 0 1 exit0
		lw 0 2 one
		beq 2 1 exit1
		sw 5 1 Stack
