mend	sw 0 3 result
		halt
		beq 0 0 beg1
mend1	halt
mul		lw 0 4 mcand
		lw 0 2 nloop
		lw 0 7 zero
		lw 0 3 none
begin	beq 0 2 end
		add 3 2 2
		lw 0 5 mplier
		lw 0 1 mone
		add 0 4 6
		nor 6 6 6
		nor 1 1 1
		nor 6 1 6
